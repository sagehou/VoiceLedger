{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceLedger test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "test_id", "status", "build_commit", "environment",
    "input_corpus_sha256", "steps", "expected", "actual", "metrics", "evidence_path",
    "unresolved_risks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "test_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["not_run", "pass", "fail", "blocked"] },
    "build_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environment": { "type": "object", "minProperties": 1 },
    "input_corpus_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "expected": { "type": "string", "minLength": 1 },
    "actual": { "type": ["string", "null"], "minLength": 1 },
    "metrics": { "type": "object" },
    "evidence_path": { "type": ["string", "null"], "minLength": 1 },
    "unresolved_risks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "if": { "properties": { "status": { "enum": ["pass", "fail"] } } },
  "then": { "properties": { "actual": { "type": "string" }, "evidence_path": { "type": "string" } } }
}
