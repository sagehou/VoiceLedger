{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceLedger model catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Model"}}
  },
  "$defs": {
    "Text": {"type": "string", "minLength": 1},
    "Https": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "Model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "version", "mode", "quantization", "languages", "runtime", "license",
        "targets", "artifacts", "peak_ram_estimate"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"$ref": "#/$defs/Text"},
        "version": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "mode": {"enum": ["lightweight", "balanced", "enhanced"]},
        "quantization": {"$ref": "#/$defs/Text"},
        "languages": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z]{2,3}$"},
          "allOf": [{"contains": {"const": "zh"}}, {"contains": {"const": "en"}}, {"contains": {"const": "ja"}}]
        },
        "runtime": {"$ref": "#/$defs/Runtime"},
        "license": {"$ref": "#/$defs/License"},
        "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Target"}},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/Artifact"}},
        "peak_ram_estimate": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/MemoryEstimate"}]}
      }
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source_url"],
      "properties": {
        "id": {"$ref": "#/$defs/Text"},
        "version": {"$ref": "#/$defs/Text"},
        "source_url": {"$ref": "#/$defs/Https"}
      }
    },
    "License": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": {"enum": ["MIT", "LicenseRef-FunASR-Model"]},
        "url": {"$ref": "#/$defs/Https"}
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "abi", "min_os", "cpu_features"],
      "properties": {
        "platform": {"enum": ["windows", "android"]},
        "abi": {"$ref": "#/$defs/Text"},
        "min_os": {"type": "integer", "minimum": 1},
        "cpu_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "url", "size_bytes", "sha256"],
      "properties": {
        "file": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*[A-Za-z0-9]$"},
        "url": {"type": "string", "pattern": "^https://huggingface\\.co/[^\\s]+/resolve/[0-9a-f]{40}/[^/\\s]+$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "MemoryEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "source_url"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "source_url": {"$ref": "#/$defs/Https"}
      }
    }
  }
}
