<Window x:Class="VoiceLedger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceLedger" Width="800" Height="560" MinWidth="640" MinHeight="490"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,18">
      <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" FontFamily="Consolas" FontSize="26"
                 AutomationProperties.Name="Recording elapsed time" />
      <TextBlock Text="Recording" FontSize="26" FontWeight="SemiBold" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="132" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Label Content="_Source mode" Target="{Binding ElementName=ModeSelector}" />
      <DockPanel Grid.Column="1" Margin="0,0,0,6">
        <Button DockPanel.Dock="Right" Content="Refresh devices" Padding="10,4" Margin="8,0,0,0"
                IsEnabled="{Binding CanSelect}" Click="RefreshDevices" />
        <ComboBox x:Name="ModeSelector" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                  IsEnabled="{Binding CanSelect}" />
      </DockPanel>
      <Label Grid.Row="1" Content="_Microphone" Target="{Binding ElementName=MicSelector}" />
      <ComboBox x:Name="MicSelector" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" ItemsSource="{Binding Microphones}"
                DisplayMemberPath="Display" SelectedItem="{Binding Microphone}" IsEnabled="{Binding CanSelectMic}" />
      <Label Grid.Row="2" Content="System _loopback" Target="{Binding ElementName=SystemSelector}" />
      <ComboBox x:Name="SystemSelector" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RenderEndpoints}"
                DisplayMemberPath="Display" SelectedItem="{Binding SystemEndpoint}" IsEnabled="{Binding CanSelectSystem}"
                ToolTip="Captures the selected Windows render endpoint's system mix." />
    </Grid>

    <WrapPanel Grid.Row="2" Margin="0,0,0,14">
      <Button Content="Start recording" Padding="12,6" Margin="0,0,8,6" IsEnabled="{Binding CanStart}" Click="StartRecording" />
      <Button Content="Pause" Padding="12,6" Margin="0,0,8,6" IsEnabled="{Binding CanPause}" Click="PauseRecording" />
      <Button Content="Resume" Padding="12,6" Margin="0,0,8,6" IsEnabled="{Binding CanResume}" Click="ResumeRecording" />
      <Button Content="Stop recording" Padding="12,6" Margin="0,0,8,6" IsEnabled="{Binding CanStop}" Click="StopRecording" />
      <Button Content="Models" Padding="12,6" Margin="0,0,8,6" Click="OpenModels" />
    </WrapPanel>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Tracks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="0,1,0,0" Padding="0,10" Margin="0,0,0,6">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Reconnect endpoint" Padding="10,4" Margin="12,0,0,0"
                        VerticalAlignment="Center" IsEnabled="{Binding CanReconnect}" Click="ReconnectEndpoint" />
                <StackPanel>
                  <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Status}" />
                  <TextBlock Text="{Binding Saved}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <DockPanel Grid.Row="4" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Open recording folder" IsEnabled="{Binding HasOutput}"
              Padding="10,4" Margin="12,0,0,0" Click="OpenRecordingFolder" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
